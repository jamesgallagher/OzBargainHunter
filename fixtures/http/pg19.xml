<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no"/>
    <title>500 Internal Error - OzBargain</title>
  <link rel="stylesheet" type="text/css" href="/files/css/pagesimple.css?ver=853"/>
  <link rel="stylesheet" media="all" type="text/css" href="/themes/ozbargain/style.css?ver=853"/>
  <script>
    (()=>{
      const dm = window.localStorage.getItem('color_scheme');
      document.documentElement.setAttribute('data-color-scheme', dm == 'dark' ? 'dark' : (dm == 'light' ? 'light' : ((window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light')));
    })();
  </script>
</head>
<body class="simple">
  <div id="wrap">
    <header><a href="/"><img src="/themes/ozbargain/logo.png" alt="Logo"/></a></header>
    <main>
      <h2>500 Internal Error</h2>
                  <p class="reason">Reason: <em>Page limit reached</em></p>
          </main>
  </div>
</body>
</html>
