# The build context (design 10.4). Only what the image needs is sent to the
# daemon: a local `.next/`, `node_modules/`, database file or scratch directory
# must never reach the builder, and a stale local build must never be able to
# stand in for the one the image builds.
.git
.github
node_modules
.next
out
*.db
*.db-wal
*.db-shm
*.log
unraid
docs
coverage

# Local environment files and pipeline worktrees must not enter the build context.
.env
.env.*
.worktrees/

# Browser installs, spike captures and the local coding agent's state are never
# part of the image: the browser is installed by the Dockerfile itself
# (--only-shell chromium), so a local one must not be able to stand in for it.
.playwright-browsers
spike-output
.qwen
