{
  "name": "ozbargain-hunter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal deal and classifieds watcher for OzBargain",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "worker": "node scripts/run-worker.mjs",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --test-timeout=20000 --import ./test/support/no-network.js --import ./test/support/jsx-loader.mjs test/unit/**/*.test.js test/guards/*.test.js",
    "test:foundation": "node --test --test-timeout=20000 --import ./test/support/no-network.js test/unit/foundation/*.test.js test/guards/*.test.js",
    "test:acquisition": "node --test --test-timeout=20000 --import ./test/support/no-network.js test/unit/acquisition/*.test.js",
    "test:rules": "node --test --test-timeout=20000 --import ./test/support/no-network.js test/unit/rules/*.test.js",
    "test:web": "node --test --test-timeout=20000 --import ./test/support/no-network.js --import ./test/support/jsx-loader.mjs test/unit/web/*.test.js",
    "test:integration": "node --test --test-timeout=180000 --test-concurrency=4 --import ./test/support/no-network.js --import ./test/support/jsx-loader.mjs test/integration/*.test.js",
    "test:shakeout": "node --test --test-timeout=180000 --test-concurrency=4 --import ./test/support/no-network.js --import ./test/support/jsx-loader.mjs test/integration/mock-alert-delivery.test.js test/integration/ui-shakeout.test.js",
    "test:container": "node --test --test-timeout=60000 --test-concurrency=1 --import ./test/support/no-network.js test/container/*.test.js",
    "test:guards": "node --test --test-timeout=20000 --import ./test/support/no-network.js test/guards/*.test.js",
    "smoke:image": "node scripts/smoke-image.mjs"
  },
  "dependencies": {
    "cheerio": "^1.1.0",
    "fast-xml-parser": "^5.2.3",
    "jose": "^6.1.3",
    "next": "^15.5.0",
    "nodemailer": "^7.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "1.63.0"
  }
}
